generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String             @id @default(uuid())
  name                     String
  email                    String             @unique
  passwordHash             String
  roleId                   String
  branchId                 String?
  isActive                 Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  status                   String             @default("ACTIVE")
  phone                    String?
  address                  String?
  employeeId               String?            @unique
  customerId               String?            @unique
  gstNumber                String?            @default("")
  companyName              String?            @default("")
  department               String?            @default("Supply Chain")
  designation              String?            @default("Operations Executive")
  city                     String?            @default("Hyderabad")
  state                    String?            @default("Telangana")
  country                  String?            @default("India")
  lastLogin                DateTime?
  currentLoginAt           DateTime?
  lastLoginAt              DateTime?
  branchName               String             @default("Head Office")
  customerType             String             @default("STANDARD")
  assignedEmployeeId       String?
  inheritBranchPermissions Boolean            @default(true)
  pagePermissions          String?
  reportsToId              String?
  notifications            Notification[]
  purchaseOrders           PurchaseOrder[]
  reservations             StockReservation[] @relation("CustomerReservations")
  createdReservations      StockReservation[] @relation("EmployeeReservations")
  opportunities            Opportunity[]
  assignedEmployee         User?              @relation("EmployeeCustomers", fields: [assignedEmployeeId], references: [id])
  customers                User[]             @relation("EmployeeCustomers")
  reportsTo                User?              @relation("UserHierarchy", fields: [reportsToId], references: [id])
  subordinates             User[]             @relation("UserHierarchy")
  profileRequests          ProfileUpdateRequest[]
  branch                   Branch?            @relation(fields: [branchId], references: [id])
  role                     Role               @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([branchId])
  @@index([status])
  @@index([assignedEmployeeId])
  @@index([reportsToId])
  @@index([customerId])
}

model Role {
  id    String @id @default(uuid())
  name  String @unique
  users User[]
}

model Branch {
  id              String      @id @default(uuid())
  name            String      @unique
  pagePermissions String?
  inventories     Inventory[]
  users           User[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id             String             @id @default(uuid())
  sku            String             @unique
  name           String
  categoryId     String
  brand          String
  serialTracking Boolean            @default(false)
  barcode        String?
  reorderLevel   Int                @default(10)
  safetyStock    Int                @default(5)
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  inventories    Inventory[]
  category       Category           @relation(fields: [categoryId], references: [id])
  reservations   StockReservation[]
  reservationItems StockReservationItem[]
  poItems        PoItem[]

  @@index([brand])
  @@index([categoryId])
  @@index([status])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String
  branchId       String
  availableStock Int      @default(0)
  reservedStock  Int      @default(0)
  allocatedStock Int      @default(0)
  damagedStock   Int      @default(0)
  reorderLevel   Int      @default(8)
  updatedAt      DateTime @updatedAt
  itemName       String   @default("")
  sku            String   @default("")
  branchCode     String   @default("")
  quantity       Int      @default(0)
  availableQty   Int      @default(0)
  reservedQty    Int      @default(0)
  allocatedQty   Int      @default(0)
  damagedQty     Int      @default(0)
  returnedQty    Int      @default(0)
  transitQty     Int      @default(0)
  incomingQty    Int      @default(0)
  outgoingQty    Int      @default(0)
  deadQty        Int      @default(0)
  minStock       Int      @default(5)
  maxStock       Int      @default(200)
  warehouseZone  String   @default("A1")
  ageingDays     Int      @default(0)
  createdAt      DateTime @default(now())
  branch         Branch   @relation(fields: [branchId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([sku])
  @@index([branchCode])
}

model InventoryMovement {
  id         String   @id @default(uuid())
  sku        String
  branchCode String
  type       String
  quantity   Int
  details    String
  timestamp  DateTime @default(now())
  userId     String?

  @@index([sku])
  @@index([branchCode])
  @@index([timestamp])
}

model StockAlert {
  id         String   @id @default(uuid())
  type       String
  message    String
  branchCode String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([branchCode])
  @@index([resolved])
  @@index([createdAt])
}

model ProductPrice {
  id           String   @id @default(uuid())
  sku          String
  branchCode   String
  costPrice    Float
  sellingPrice Float
  mrp          Float    @default(0.0)
  margin       Float
  lastUpdated  DateTime @default(now())

  @@unique([sku, branchCode])
  @@index([sku])
  @@index([branchCode])
}

model ProductPriceHistory {
  id           String   @id @default(uuid())
  sku          String
  branchCode   String
  costPrice    Float
  sellingPrice Float
  mrp          Float    @default(0.0)
  updatedBy    String
  updatedAt    DateTime @default(now())

  @@index([sku])
  @@index([branchCode])
  @@index([updatedAt])
}


model StockReservation {
  id                String    @id @default(uuid())
  reservationNumber String    @unique
  customerId        String
  employeeId        String?
  productId         String?
  sku               String?
  branchCode        String    @default("HYD-HQ")
  quantity          Int?
  status            String    @default("PENDING")
  notes             String?
  project           String?            @default("Default Project")
  reservedAt        DateTime  @default(now())
  expiresAt         DateTime
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation("CustomerReservations", fields: [customerId], references: [id])
  employee          User?     @relation("EmployeeReservations", fields: [employeeId], references: [id])
  product           Product?  @relation(fields: [productId], references: [id])
  items             StockReservationItem[]

  // Phase 18 timestamps
  verifiedAt        DateTime?
  processingAt      DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  draftedAt         DateTime?

  @@index([customerId])
  @@index([employeeId])
  @@index([productId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model StockReservationItem {
  id            String           @id @default(uuid())
  reservationId String
  productId     String
  sku           String
  quantity      Int
  status        String           @default("PENDING")
  reservedQty   Int              @default(0)
  shortageQty   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id])

  @@index([reservationId])
  @@index([productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PurchaseOrder {
  id                 String       @id @default(uuid())
  poNumber           String       @unique
  customerId         String
  customerName       String
  companyName        String       @default("")
  vendorId           String?
  totalAmount        Decimal      @default(0) @db.Decimal(10, 2)
  dateReceived       DateTime     @default(now())
  expectedDelivery   DateTime?
  totalItems         Int
  stockStatus        String       @default("Checking")
  verificationStatus String       @default("Pending")
  verifiedBy         String?
  verifiedDate       DateTime?
  branchCode         String       @default("HYD-HQ")
  itemsJson          String       @default("[]")
  user               User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor             Vendor?      @relation(fields: [vendorId], references: [id])
  opportunity        Opportunity?
  poItems            PoItem[]

  @@index([customerId])
  @@index([vendorId])
  @@index([branchCode])
  @@index([verificationStatus])
  @@index([dateReceived])
  @@index([customerId, verificationStatus])
}

model Opportunity {
  id                 String        @id @default(uuid())
  opportunityNumber  String        @unique
  customerId         String
  customerName       String
  companyName        String        @default("")
  purchaseOrderId    String?       @unique
  productDetails     String        @default("[]")
  totalQuantity      Int           @default(0)
  reservationDate    DateTime      @default(now())
  expiryDate         DateTime
  status             String        @default("OPEN")
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  purchaseOrder      PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  user               User          @relation(fields: [customerId], references: [id])

  // Phase 18 Sync fields
  reservationId      String?
  product            String?
  requestedDeliveryDate DateTime?
  reservationStatus  String?
  assignedExecutive  String?
  branch             String?

  @@index([customerId])
  @@index([status])
  @@index([purchaseOrderId])
  @@index([createdAt])
}

// ─── erpstructure models ──────────────────────────────────────────────────────

model Vendor {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String          @default("")
  email          String          @default("")
  phone          String          @default("")
  address        String          @default("")
  gstNumber      String          @default("")
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([name])
}

model PoItem {
  id            String        @id @default(uuid())
  poId          String
  productId     String
  sku           String
  productName   String        @default("")
  quantity      Int
  unitPrice     Decimal       @default(0) @db.Decimal(10, 2)
  itemStatus    String        @default("Pending")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([sku])
  @@index([itemStatus])
}

model ProfileUpdateRequest {
  id               String    @id @default(uuid())
  userId           String
  contactPerson    String
  email            String
  phone            String
  companyAddress   String
  alternateContact String?
  status           String    @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

